import PageWrap from "@/components/ui/PageWrap";
import PageHeader from "@/components/ui/PageHeader";
import Bullet from "@/components/ui/Bullet";
// @ts-expect-error — data file is JS-style, shape validated at runtime
import { INT } from "@/data/inmuno";

// INT shape: { t: "Sistema Inmunitario", s: [{t,i,c,x,p[]}] }

export default function InmunoModule() {
  return (
    <PageWrap>
      <PageHeader
        kicker="Módulo básico"
        title="Inmunología"
        tagline="Lo esencial: innata vs adaptativa, inmunoglobulinas, órganos linfoides y blancos terapéuticos."
        icon="🛡️"
        accent="#60a5fa"
      />

      <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
        {INT.s.map((item: any, i: number) => (
          <article
            key={i}
            className="relative p-5 rounded-2xl bg-grad-surface border border-white/[0.06] overflow-hidden"
            style={{ boxShadow: `inset 0 0 0 1px ${item.c}22` }}
          >
            <div className="flex items-center gap-3 mb-2.5">
              <span
                className="w-10 h-10 rounded-xl flex items-center justify-center text-[20px]"
                style={{ background: `${item.c}22`, border: `1px solid ${item.c}44` }}
              >
                {item.i}
              </span>
              <h3 className="font-display font-semibold text-[17px] tracking-tight">{item.t}</h3>
            </div>
            {item.x && <p className="text-[13.5px] text-ink-muted leading-relaxed mb-3">{item.x}</p>}
            {item.p?.length > 0 && <Bullet items={item.p} accent={item.c} />}
          </article>
        ))}
      </div>
    </PageWrap>
  );
}
